# cp .env.example .env   (.env is git-ignored)
JENKINS_ADMIN_PASSWORD=change-me

# Absolute paths on your machine, mounted read-only into the container.
# (terraform/terraform.tfvars is taken from the mounted project, nothing to set)
# service account key (tfvars: sa_key_file = "~/.yc/key.json")
YC_SA_KEY_FILE=~/.yc/key.json
# SSH private key; the .pub next to it is mounted too (tfvars: ssh_*_key_path keep the defaults)
SSH_KEY_FILE=/.ssh/id_yc_mycloud
